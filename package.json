{
  "name": "dsh-memu-memory",
  "icon": "./assets/icon.png",
  "version": "1.0.0",
  "description": "为 DeepSeek Harness 提供本地优先的记忆：三层记忆、来源标注、关系图、图片附件与独立 WebUI，可选 MemU 引擎。",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "memory",
    "memu",
    "agent-memory",
    "ai-memory",
    "chat-memory",
    "deepseek",
    "local-first",
    "memory-plugin",
    "relationship-graph",
    "webui",
    "javascript"
  ],
  "homepage": "https://github.com/Tkingxiao/dsh-memu-memory#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tkingxiao/dsh-memu-memory.git"
  },
  "bugs": {
    "url": "https://github.com/Tkingxiao/dsh-memu-memory/issues"
  },
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./integration": "./lib/inbound.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-memu-memory-setup": "./scripts/setup.mjs"
  },
  "files": [
    "lib",
    "scripts",
    "cordis.patch.yml",
    "requirements.lock",
    "README.md",
    "assets",
    "AGENTS.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "build:graph": "node scripts/build-graph.mjs",
    "test:graph-browser": "node scripts/check-graph-browser.mjs",
    "check": "node scripts/check-all.mjs",
    "setup": "node scripts/setup.mjs",
    "test": "node --import ./tests/loader-register.mjs --test tests/*.test.mjs"
  },
  "engines": {
    "node": ">=20.9.0",
    "dsh": ">=0.2.0-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-store",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ],
      "immediately": true
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0-rc <5",
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.1 <0.3.0",
    "@deepseek-ai/dsh-session": ">=0.2.0-rc.1 <0.3.0",
    "@deepseek-ai/dsh-session-query": ">=0.2.0-rc.1 <0.3.0",
    "@deepseek-ai/dsh-subagent": ">=0.2.0-rc.1 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.1 <0.3.0",
    "@deepseek-ai/schemastery": "^3.18.0",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-session-query": {
      "optional": true
    },
    "@deepseek-ai/dsh-subagent": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "dependencies": {
    "fflate": "0.8.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tar": "7.5.22",
    "sharp": "0.35.5"
  },
  "license": "MIT",
  "devDependencies": {
    "d3-force": "3.0.0",
    "esbuild": "0.28.2",
    "playwright": "1.64.1"
  }
}
